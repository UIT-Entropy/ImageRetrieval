# Kaggle > Settings > API: dán API token của chính bạn.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=

# Được điền tự động bởi manage_encoder.py connect; để trống lúc cài.
IMAGE_ENCODER_URL=
IMAGE_ENCODER_KEY=

# Thư mục do download_data.py tạo.
IMAGE_DATA_DIR=data
IMAGE_ARTIFACT_DIR=source/image_retrieval/output/image_retrieval_output
IMAGE_API_HOST=127.0.0.1
IMAGE_API_PORT=8100

# Profile GPU local. Điều chỉnh theo VRAM/RAM của máy chạy.
QWEN_QUANTIZATION=4bit
QWEN_GPU_MEMORY=4GiB
QWEN_CPU_MEMORY=4GiB

# Tùy chọn: đường dẫn executable nếu API không tìm thấy codex trên PATH.
CODEX_QUERY_EXECUTABLE=
