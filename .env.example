# Used by both profiles; paths are relative to the repository root.
IMAGE_DATA_DIR=data
IMAGE_ARTIFACT_DIR=source/image_retrieval/output/image_retrieval_output
IMAGE_API_HOST=127.0.0.1
IMAGE_API_PORT=8100

# Laptop GPU: sequential NF4 embedding + reranker.
QWEN_QUANTIZATION=4bit
QWEN_GPU_MEMORY=4GiB
QWEN_CPU_MEMORY=4GiB

# Kaggle GPU: connect writes the URL/key below automatically.
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
IMAGE_ENCODER_URL=
IMAGE_ENCODER_KEY=
